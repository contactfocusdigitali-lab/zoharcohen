rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Must match SERVICE_OPTIONS in src/components/ContactForm.jsx.
    function allowedServices() {
      return ['קיפול כביסה וגיהוץ', 'סידורי ארונות', 'הסעות לבית הספר ולחוגים', 'עוד לא בטוחים'];
    }

    function isValidLead(d) {
      return d.keys().hasOnly(['name', 'phone', 'service', 'consent', 'consentVersion', 'createdAt'])
        && d.keys().hasAll(['name', 'phone', 'service', 'consent', 'consentVersion', 'createdAt'])
        // name: non-empty after trimming, max 100 chars
        && d.name is string
        && d.name.trim().size() > 0
        && d.name.size() <= 100
        // phone: Israeli format, same as the form's pattern (0 + 8-12 digits/spaces/hyphens)
        && d.phone is string
        && d.phone.matches('^0[0-9 -]{8,12}$')
        // service: one of the form's options only
        && d['service'] is string
        && d['service'] in allowedServices()
        // explicit consent (checkbox) + which wording version was shown, e.g. 2026-11-14.4
        && d.consent == true
        && d.consentVersion is string
        && d.consentVersion.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}([.][0-9]{1,3})?$')
        // server timestamp only
        && d.createdAt == request.time;
    }

    // Public landing-page form: anyone may submit a lead; nobody may read, list,
    // update or delete leads from the browser. Leads are viewed in the Firebase
    // console / synced to the owner's sheet with the owner's own credentials.
    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow read, update, delete: if false;
    }

    // Everything else (including any future collection) is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public landing-page form: anyone may submit a lead, nobody may read or change them.
    // Leads are viewed in the Firebase console (admin access bypasses these rules).
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'service', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 20
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() <= 60
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
